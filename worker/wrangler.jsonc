{
  "name": "taipei-issue-tracker",
  "account_id": "c0ce3d99729c95aff97986f5fabe60a6",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "build": { "command": "node build.mjs" },
  "assets": { "directory": "./public", "run_worker_first": ["/api/*"] },
  // 10 AI calls per IP per minute; 20 db writes per visitor id per minute; 150 new visitor ids per IP per minute (venue Wi-Fi shares one IP); 10 photos per visitor id per minute
  "ratelimits": [
    { "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "WRITE_LIMITER", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } },
    { "name": "VISITOR_LIMITER", "namespace_id": "1003", "simple": { "limit": 150, "period": 60 } },
    { "name": "PHOTO_LIMITER", "namespace_id": "1004", "simple": { "limit": 10, "period": 60 } },
    // Demo admin needs no token, so its writes and uploads are capped per IP instead
    { "name": "ADMIN_LIMITER", "namespace_id": "1005", "simple": { "limit": 120, "period": 60 } }
  ],
  // Report photos (JPEG/WebP, already resized in the browser); keys are <visitor id>/<uuid>.jpg, admin/<uuid>.jpg or demo/<name>.jpg
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "taipei-issue-photos" }],
  // Secrets: VISITOR_SECRET, ANTHROPIC_API_KEY (local: worker/.dev.vars)
  "durable_objects": { "bindings": [{ "name": "HUB", "class_name": "Hub" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Hub"] }],
  "observability": { "enabled": true },
  // Daily 01:00 UTC (09:00 Taipei): refresh the news fallback snapshot (Hub.refreshNews)
  "triggers": { "crons": ["0 1 * * *"] }
}
